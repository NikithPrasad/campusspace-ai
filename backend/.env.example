PORT=5000
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/campusspace_ai?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development
